#!/usr/bin/env bash
# Cheap-agent isolation guard (S274) — soft tier.
#
# Blocks any commit that touches the Claude control plane unless a Claude
# session explicitly opts in with CLAUDE_CTL=1. Gemini/Aider run as root (same
# user as Claude), so this is accident-prevention + a default-deny backstop —
# NOT kernel-enforced read-only. Aider is additionally contained at the context
# layer by .aiderignore; Gemini respects the boundary by policy.
# A determined process can still bypass (git commit --no-verify, direct write).
# Policy + rationale: docs/MODEL_HIERARCHY.md §File Boundaries.
#
# Activate (once, local config): git config core.hooksPath .githooks

protected='^(\.claude/|CLAUDE\.md|SESSION_CONTEXT\.md)'
staged="$(git diff --cached --name-only | grep -E "$protected" || true)"

# (The S340 guest-lane NEXT-line carve-out was retired 2026-10-28: guest lanes carry no
# SESSION_CONTEXT line; reviews arrive as files.)

if [ -n "$staged" ] && [ "$CLAUDE_CTL" != "1" ]; then
  echo "" >&2
  echo "BLOCKED — commit touches Claude control-plane files (read-only to Gemini/Aider, S274):" >&2
  echo "$staged" | sed 's/^/  - /' >&2
  echo "" >&2
  echo "If you are a Claude session legitimately editing the control plane," >&2
  echo "re-run the commit with CLAUDE_CTL=1 prefixed. e.g.:" >&2
  echo "  CLAUDE_CTL=1 git commit -m \"...\"" >&2
  echo "" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# ROLLOUT conformance gate (S335)
#
# A non-conforming ROLLOUT row is SILENTLY SKIPPED by scripts/rolloutSweep.js —
# it never archives, so the work stops being tracked without anyone noticing.
# docLoopStatus already detects this, but --lint exits 0 by design (it surfaces,
# it does not decide), so a chained `--lint && git commit` commits the bad row
# anyway. That happened TWICE in S335. A validator that cannot stop the action is
# not enforcement. This is the gate; --gate exits non-zero.
# ---------------------------------------------------------------------------
if git diff --cached --name-only | grep -q '^docs/engine/ROLLOUT_PLAN\.md$'; then
  if ! lint_out="$(node scripts/docLoopStatus.js --gate 2>&1)"; then
    echo "" >&2
    echo "BLOCKED — ROLLOUT_PLAN.md has non-conforming rows (S335 gate):" >&2
    echo "$lint_out" | sed 's/^/  /' >&2
    echo "" >&2
    echo "A malformed row never archives and its work stops being tracked." >&2
    echo "Fix the row, or drain the narrative to its plan doc:" >&2
    echo "  node scripts/rolloutDrain.js --id=<row> --title=\"...\" --state=<state>" >&2
    echo "" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# SESSION_CONTEXT shape gate (builder 2026-10-28): header, one PIN, one NEXT per
# Claude terminal — nothing else; PIN and NEXT under their caps.
# ---------------------------------------------------------------------------
if git diff --cached --name-only | grep -q '^SESSION_CONTEXT\.md$'; then
  if ! sc_out="$(node scripts/docLoopStatus.js --gate-handoff 2>&1)"; then
    echo "" >&2
    echo "BLOCKED — SESSION_CONTEXT.md is a handoff, not a log:" >&2
    echo "$sc_out" | sed 's/^/  /' >&2
    echo "" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# Canon-leak gate — sim-facing/agent-read files (.claude/agents/,
# .claude/agent-memory/, docs/canon/, docs/media/) must never gain real-world
# dates or builder references. Catches Bash-side writes (sed/echo/python) the
# PreToolUse hook cannot see. Runs regardless of CLAUDE_CTL — this protects
# canon, not the control plane. Detail: .claude/hooks/canon-leak-guard.sh
# ---------------------------------------------------------------------------
if ! bash "$(git rev-parse --show-toplevel)/.claude/hooks/canon-leak-guard.sh" --staged; then
  exit 1
fi

# Civic gate — the vote is the gate (builder ruling 2026-10-04; kept and wired
# on builder's word 2026-10-06). A new refusal on the civic move path blocks;
# catches Bash-side writes the PreToolUse hook cannot see. Runs regardless of
# CLAUDE_CTL. Detail: .claude/hooks/civic-gate-guard.sh
if ! bash "$(git rev-parse --show-toplevel)/.claude/hooks/civic-gate-guard.sh" --staged; then
  exit 1
fi

# ---------------------------------------------------------------------------
# Writer exit-code lint (governance.49) — ratcheted standing check for the
# writer-fixed/artifact-persists class: a script whose delete/replace failure
# counter never reaches its exit code. Blocks ONLY on exit 1 (new un-ratcheted
# offenders or a stale ratchet entry); the ratchet means existing debt stays
# silent. Any other exit (lint crash, missing node) warns and fails open — a
# broken lint must not halt every lane's commits.
# ---------------------------------------------------------------------------
lint_out="$(node "$(git rev-parse --show-toplevel)/scripts/auditWriterExitCodes.js" --gate 2>&1)"
lint_rc=$?
if [ "$lint_rc" = "1" ]; then
  echo "" >&2
  echo "BLOCKED — new unguarded writer script(s) (governance.49 lint):" >&2
  echo "$lint_out" | sed 's/^/  /' >&2
  echo "" >&2
  echo "Give the writer an exit-code gate, or ratchet the instance to its" >&2
  echo "rollout row in scripts/auditWriterExitCodes.js KNOWN_OPEN." >&2
  echo "" >&2
  exit 1
elif [ "$lint_rc" != "0" ]; then
  echo "pre-commit: writer-exit lint unavailable (rc=$lint_rc) — failing open" >&2
fi

exit 0
