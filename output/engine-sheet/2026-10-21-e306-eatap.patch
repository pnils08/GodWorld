+// BENCH-ONLY DIAGNOSTIC (engine.306 gate-3 FIX), never merged: read-only per-phase marks — ctx.rng.draws (the
+// generator's own counter, cycleModes.js seededRng_) and S.worldEvents / storySeeds / storyHooks lengths before and
+// after each phase; the S.worldEvents identity list as Phase5-BusinessDynamics opens. Writes ctx.__eaMarks /
+// ctx.__eaPre5 only (never ctx.summary); a tap fault is swallowed so it cannot fail a phase.
+function eaDiagEventId_(e) {
+  e = e || {};
+  return [e.domain || '', e.subdomain || '', e.source || '', e.neighborhood || '', e.severity || '',
+    String(e.description || e.summary || e.title || '').slice(0, 60)].join('|');
+}
+function eaDiagPre_(ctx, phaseName) {
+  try {
+    var S = ctx && ctx.summary;
+    var we = S && S.worldEvents;
+    if (phaseName === 'Phase5-BusinessDynamics' && we) ctx.__eaPre5 = we.map(eaDiagEventId_);
+    return [phaseName, ctx && ctx.rng && typeof ctx.rng.draws === 'number' ? ctx.rng.draws : null, we ? we.length : null];
+  } catch (eaE) { return [phaseName, 'tap-error']; }
+}
+function eaDiagPost_(ctx, m) {
+  try {
+    var S = ctx && ctx.summary;
+    m.push(ctx && ctx.rng && typeof ctx.rng.draws === 'number' ? ctx.rng.draws : null,
+      S && S.worldEvents ? S.worldEvents.length : null, S && S.storySeeds ? S.storySeeds.length : null,
+      S && S.storyHooks ? S.storyHooks.length : null);
+    (ctx.__eaMarks = ctx.__eaMarks || []).push(m);
+  } catch (eaE) {}
+}
