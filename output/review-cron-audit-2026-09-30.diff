+// The write wake scans against its packet, so a phrase grounded by the story's
+// own assignment (articleContamination `groundedBy`) stages clean; this door
+// re-scanned with no packet and would turn the same Article away. Read the
+// handoff packet the stage wrote beside it; absent or unreadable → no packet,
+// which is the strict reading.
+function stagedHandoffPacket(side) {
+  const m = /^(.*_packet-v\d+_)/.exec(path.basename(String(side && side.article || '')));
+  if (!m) return null;
+  try {
+    return JSON.parse(fs.readFileSync(path.join(ROOT, 'output', 'cron-compare', m[1] + 'packet.json'), 'utf8'));
+  } catch (_) { return null; }
+}
