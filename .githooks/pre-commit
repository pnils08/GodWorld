#!/usr/bin/env bash
# Cheap-agent isolation guard (S274) — soft tier.
#
# Blocks any commit that touches the Claude control plane unless a Claude
# session explicitly opts in with CLAUDE_CTL=1. Gemini/Aider run as root (same
# user as Claude), so this is accident-prevention + a default-deny backstop —
# NOT kernel-enforced read-only. Aider is additionally contained at the context
# layer by .aiderignore; Gemini respects the boundary by policy.
# A determined process can still bypass (git commit --no-verify, direct write).
# Policy + rationale: docs/MODEL_HIERARCHY.md §File Boundaries.
#
# Activate (once, local config): git config core.hooksPath .githooks

protected='^(\.claude/|CLAUDE\.md|SESSION_CONTEXT\.md)'
staged="$(git diff --cached --name-only | grep -E "$protected" || true)"

# --- EXTERNAL-LANE HANDOFF CARVE-OUT (S340) ---
# kimi / codex / antigravity carry a NEXT line in SESSION_CONTEXT.md and close by
# rewriting it (AGENTS.md §Session close). Without this, that write is a
# control-plane edit they cannot make, so their lanes would sit frozen at
# whatever a Claude terminal typed once and the handoff would be decoration.
#
# The carve-out is deliberately the narrowest thing that works: SESSION_CONTEXT.md
# must be the ONLY protected path staged, and every changed line in it must be a
# NEXT line for ONE external lane. A PIN edit, another lane's line, a second
# control-plane file, or any prose all fall through to the block below. Telling
# these agents to set CLAUDE_CTL=1 was the alternative and it would hand them the
# whole control plane to fix one line.
if [ "$staged" = "SESSION_CONTEXT.md" ] && [ "$CLAUDE_CTL" != "1" ]; then
  sc_changes="$(git diff --cached -U0 -- SESSION_CONTEXT.md \
    | grep -E '^[+-]' | grep -Ev '^(\+\+\+|---)' || true)"
  sc_lanes="$(printf '%s\n' "$sc_changes" \
    | sed -nE 's/^[+-]\*\*NEXT\[(kimi|codex|antigravity)\]:\*\*.*/\1/p' \
    | sort -u)"
  sc_offending="$(printf '%s\n' "$sc_changes" \
    | grep -Ev '^[+-]\*\*NEXT\[(kimi|codex|antigravity)\]:\*\*' || true)"
  if [ -n "$sc_changes" ] && [ -z "$sc_offending" ] \
     && [ "$(printf '%s\n' "$sc_lanes" | grep -c .)" = "1" ]; then
    echo "pre-commit: external-lane handoff — NEXT[$sc_lanes] only, control-plane gate waived (S340)."
    staged=""
  fi
fi

if [ -n "$staged" ] && [ "$CLAUDE_CTL" != "1" ]; then
  echo "" >&2
  echo "BLOCKED — commit touches Claude control-plane files (read-only to Gemini/Aider, S274):" >&2
  echo "$staged" | sed 's/^/  - /' >&2
  echo "" >&2
  echo "If you are a Claude session legitimately editing the control plane," >&2
  echo "re-run the commit with CLAUDE_CTL=1 prefixed. e.g.:" >&2
  echo "  CLAUDE_CTL=1 git commit -m \"...\"" >&2
  echo "" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# ROLLOUT conformance gate (S335)
#
# A non-conforming ROLLOUT row is SILENTLY SKIPPED by scripts/rolloutSweep.js —
# it never archives, so the work stops being tracked without anyone noticing.
# docLoopStatus already detects this, but --lint exits 0 by design (it surfaces,
# it does not decide), so a chained `--lint && git commit` commits the bad row
# anyway. That happened TWICE in S335. A validator that cannot stop the action is
# not enforcement. This is the gate; --gate exits non-zero.
# ---------------------------------------------------------------------------
if git diff --cached --name-only | grep -q 'docs/engine/archive/ROLLOUT_PLAN\.md'; then
  if ! lint_out="$(node scripts/docLoopStatus.js --gate 2>&1)"; then
    echo "" >&2
    echo "BLOCKED — ROLLOUT_PLAN.md has non-conforming rows (S335 gate):" >&2
    echo "$lint_out" | sed 's/^/  /' >&2
    echo "" >&2
    echo "A malformed row never archives and its work stops being tracked." >&2
    echo "Fix the row, or drain the narrative to its plan doc:" >&2
    echo "  node scripts/rolloutDrain.js --id=<row> --title=\"...\" --state=<state>" >&2
    echo "" >&2
    exit 1
  fi
fi

exit 0
