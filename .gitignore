node_modules/
package-lock.json

# Environment variables (secrets) — Phase 40.3 relocated to /root/.config/godworld/.env
# These patterns remain as belt-and-suspenders: any stray .env or credentials/ in the
# repo working dir MUST be ignored even if accidentally created.
.env
.env.*
.envx

# Service account credentials (never commit) — Phase 40.3 relocated outside repo
credentials/
*.service-account.json
*service-account.json

# SQLite database (local persistence, not tracked)
godworld/godworld.db
godworld/*.db

# Exported cycle artifacts (generated, large)
exports/*.json

# Generated media output (root-level only, not docs/media/)
/media/

# MCP server config (contains API keys)
.mcp.json

# Generated desk packets and cycle output are versioned in Git for recovery.

# Logs (generated runtime output)
logs/

# Backups (local archive copies, uploaded to Drive)
backups/

# Supermemory plugin config (may contain API keys)
.claude/.supermemory-claude/
creds.json
.venv/

# Podcast audio output (uploaded to Drive, not needed in repo)
data/audio/
.playwright-mcp/

# Graphify output (generated knowledge graph artifacts, regenerated on demand)
graphify-out/
**/graphify-out/

# Python bytecode caches (e.g., from godworld MCP server)
__pycache__/
**/__pycache__/
*.pyc
.aider*
!.aiderignore
!.aider.conf.yml


# Boot payload log — rewritten every session start, pure local diagnostic state (S341)
.claude/state/boot-payload.txt

# Session-start stamp — `date +%s` rewritten by session-startup-hook.sh at every
# boot. Only consumer is scripts/gapLogGate.js --stop-gate, which reads it off
# disk to tell this-session artifacts from older ones; it never consults git
# history, and it is FAIL-OPEN when the stamp is missing. Tracked by accident
# until S348, where it dirtied every lane's tree at every boot. (S348)
.claude/state/session-start.txt

# godworld_batch_ingest skill writes its run log to cwd (repo root) — runtime
# log, not a doc; belongs untracked like logs/. (S354)
/changelog.md

# Grok CLI local config — config.toml carries the permission allowlist,
# which includes historical commands with inline API keys. Never commit.
# Skills under .grok/skills/ are project-shared and tracked (exception below).
.grok/*
!.grok/skills/
!.grok/skills/**
