+    // capture read as current fact on 10-07). It is still written by capture.js and
+    // searched on purpose through scripts/brainSearch.js.
+    const recallTags = ['sl-godworld'];
+    const responses = await Promise.all([
+      searchRules(),
+      ...recallTags.map((tag) =>
+        getProfile(baseUrl, apiKey, tag, q, { timeoutMs: SEARCH_TIMEOUT_MS })
+          .then((r) => r?.searchResults?.results || [])
+          .catch(() => []),
+      ),
+    ]);
+
+    const results = responses
