+    // GodWorld patch 2026-09-23: recall from the shared hand-write container
+    // (sl-godworld) AND the auto-save container, merged by similarity.
+    // sl-rules = live mirror of memory files, SIM_DOCTRINE, ADRs (brainSearch.js --sync);
+    // its hits are tagged [rule] so they read as current law, not history.
+    // sl-rules is searched hybrid (/v4/search) because the value is the rule TEXT — memory
+    // extraction alone drops it. Top chunk per source file, capped, tagged [rule].
+    const baseUrl = getBaseUrl(cwd, projectConfig);
+    const q = prompt.slice(0, MAX_QUERY_LENGTH);
+    const searchRules = () => {
+      const ctl = new AbortController();
+      const timer = setTimeout(() => ctl.abort(), SEARCH_TIMEOUT_MS);
+      return fetch(`${baseUrl.replace(/\/+$/, '')}/v4/search`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${apiKey}` },
+        body: JSON.stringify({ q, containerTag: 'sl-rules', searchMode: 'hybrid', limit: 6 }),
+        signal: ctl.signal,
+      })
+        .then((r) => r.json())
+        .then((d) => {
+          const seenDocs = new Set();
+          return (d?.results || []).filter((x) => {
+            const doc = x.documents?.[0]?.id || x.id;
+            if (seenDocs.has(doc)) return false;
+            seenDocs.add(doc);
+            return true;
+          }).slice(0, 2).map((x) => ({
+            ...x,
+            memory: `[rule] ${String(x.memory || x.chunk || '').replace(/\s+/g, ' ').slice(0, 400)}`,
+          }));
+        })
+        .catch(() => [])
+        .finally(() => clearTimeout(timer));
+    };
